# OpsPulse Frontend Environment Template
# Public configuration for client-side API routing (No secrets or credentials permitted)

# Backend proxy target used by Next.js rewrites:
# - Local dev: http://127.0.0.1:8000/api
# - Vercel production: https://<your-opspulse-backend>.vercel.app/api
BACKEND_API_URL=http://127.0.0.1:8000/api

# Optional: client-side direct API URL override (defaults to /api which proxies through Next.js rewrites)
NEXT_PUBLIC_API_URL=/api
