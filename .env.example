# OpsPulse Environment Configuration Template
# Copy this file to .env and configure your credentials
# NEVER commit .env to version control

# ==========================================
# 1. PostgreSQL Data Warehouse Connection
# ==========================================
# Local Development:
# OPSPULSE_DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/opspulse_dw
# Cloud Production (Neon PostgreSQL):
# OPSPULSE_DATABASE_URL=postgresql+psycopg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
OPSPULSE_DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/opspulse_dw

# ==========================================
# 2. CORS Configuration (Backend API)
# ==========================================
# Local Development:
# OPSPULSE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production on Vercel:
# OPSPULSE_ALLOWED_ORIGINS=https://<your-opspulse-frontend>.vercel.app
OPSPULSE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# 3. Frontend API Proxy (Next.js)
# ==========================================
# Local Development:
# BACKEND_API_URL=http://127.0.0.1:8000/api
# Production on Vercel:
# BACKEND_API_URL=https://<your-opspulse-backend>.vercel.app/api
BACKEND_API_URL=http://127.0.0.1:8000/api

# ==========================================
# 4. Apache Airflow Metadata Database (Local/WSL)
# ==========================================
# (Airflow runs locally / in Docker and is NOT deployed to Vercel Serverless Functions)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg://airflow_user:password@127.0.0.1:5432/airflow_metadata
