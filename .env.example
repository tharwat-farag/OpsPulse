# OpsPulse Environment Configuration Template
# Copy this file to .env and configure your local credentials
# NEVER commit .env to version control

# PostgreSQL Data Warehouse Connection
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
OPSPULSE_DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/opspulse_dw

# Optional CORS Allowed Origins (comma-separated)
OPSPULSE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Apache Airflow Metadata Database (WSL / Local)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg://airflow_user:password@127.0.0.1:5432/airflow_metadata
